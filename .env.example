# ============================================================================
# OKEng — Environment Configuration Contract (CONFIG-001, DATA-MIG-001, CACHE-001)
# ============================================================================

# 1. Supabase Persistence, Auth & Storage (DATA-MIG-001)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Server-Side Embedded Identity Signing Secret (SECURITY-004 & EMBED-01)
OKENG_SIGNING_SECRET=

# 3. Multi-Layer Cache Configuration (CACHE-001)
# CACHE_BACKEND=auto uses RedisAdapter when REDIS_URL is configured and reachable,
# and automatically falls back to MemoryAdapter otherwise.
CACHE_BACKEND=auto
REDIS_URL=
CACHE_ENABLED=true

# 4. Optional Generative Answer Mode (ENGINE-01 Mode 3)
GEMINI_API_KEY=
