# ============================================================================
# OKEng — Environment & Staging Configuration Contract (STG-01, SEC-01, DATA-01, OPS-01)
# ============================================================================

# 1. Runtime Environment & Explicit Persistence Mode (STG-01 §1 & DATA-01 §1)
# OKENG_ENV: development | test | staging | production
# OKENG_DATA_MODE: memory (dev/test only) | supabase (mandatory in staging & production; startup fails if not supabase)
OKENG_ENV=development
OKENG_DATA_MODE=memory
PORT=3000
TRUST_PROXY_HOPS=1
OKENG_ALLOWED_ORIGINS=http://localhost:3000

# 2. Server-Only Supabase Persistence, Auth & Private Storage (SEC-01 & DB-01)
# Browser bundles never connect directly to Supabase; all Auth, DB (RLS), and Storage calls proxy through Express.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Domain A Dashboard Session, CSRF & KMS Envelope Encryption Secrets (SEC-01 §2.1–2.2)
# Must be 32+ byte high-entropy secrets in staging and production.
OKENG_SESSION_SECRET=
OKENG_CSRF_SECRET=
OKENG_KMS_MASTER_KEY=

# 4. Domain B & C Default Workspace Host Assertion Signing Secret (SEC-01 §2.2 & EMBED-01)
OKENG_SIGNING_SECRET=

# 5. Distributed Rate Limiting, Token Replay Cache & Answer Cache (OPS-01 & CACHE-001)
# In staging/production, REDIS_URL is required for distributed Lua rate limiting, jti replay protection, and token budgets.
CACHE_BACKEND=auto
REDIS_URL=
CACHE_ENABLED=true

# 6. Paid Gemini AI Service & Daily Workspace Token Budget Controls (OPS-01 §2)
GEMINI_API_KEY=
OKENG_DAILY_GEMINI_TOKEN_BUDGET=250000
OKENG_DISABLE_GENERATIVE_AI=false

